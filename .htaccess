# Two Point Singularity · Hostinger (Apache/LiteSpeed)
Options -Indexes
# never serve repository internals
RedirectMatch 404 /\.git
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
# HTTPS and no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://twopointsingularity.com%{REQUEST_URI} [L,R=301]
# Security headers
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
# Caching: pages revalidate, images and icons cache for a month
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/plain "access plus 1 day"
ExpiresByType application/xml "access plus 1 day"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
AddType text/plain;charset=utf-8 .txt
